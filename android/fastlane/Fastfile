default_platform(:android)

platform :android do
  desc "Upload an already-built AAB to Google Play (internal track)"
  lane :release do
    # The AAB is produced and signed by the previous workflow step
    # ('Build AAB for Google Play' / `./gradlew bundleRelease`). Re-running
    # the gradle build here would just rebuild it without the env vars set
    # for this step and fail signing — supply only needs the path.
    supply(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["SUPPLY_JSON_KEY_PATH"],
      package_name: "io.visio.mobile"
    )
  end
end
